# Base de la API que usa el navegador. En desarrollo dejá /api (Vite la reenvía a VITE_API_TARGET).
VITE_API_URL=/api
# Base de los archivos adjuntos (disco public de Laravel: php artisan storage:link)
VITE_FILES_URL=/storage
# Backend Laravel al que reenvía el servidor de desarrollo
VITE_API_TARGET=http://192.168.10.209:8001
# true = sin backend: login de demostración y datos de ejemplo
VITE_DEMO=false
